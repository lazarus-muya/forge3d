{
  "format": "forge3d.input_map",
  "version": 1,
  "name": "Maya",
  "bindings": [
    { "action": "nav.orbit", "input": "drag", "button": "left", "modifiers": ["alt"] },
    { "action": "nav.pan", "input": "drag", "button": "middle", "modifiers": ["alt"] },
    { "action": "nav.zoom", "input": "drag", "button": "right", "modifiers": ["alt"] },
    { "action": "nav.zoom", "input": "wheel" },
    { "action": "view.frame_selection", "input": "key", "key": "f" },
    { "action": "view.front", "input": "key", "key": "h", "modifiers": ["alt"] },
    { "action": "view.top", "input": "key", "key": "j", "modifiers": ["alt"] },
    { "action": "view.right", "input": "key", "key": "k", "modifiers": ["alt"] },
    { "action": "view.toggle_ortho", "input": "key", "key": "g", "modifiers": ["alt"] }
  ]
}
