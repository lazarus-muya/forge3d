{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows \u00b7 MSVC",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win-clangcl",
      "displayName": "Windows \u00b7 clang-cl",
      "inherits": "windows-base",
      "toolset": {
        "value": "ClangCL",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux \u00b7 GCC",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux \u00b7 Clang",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "win-msvc-full",
      "displayName": "win-msvc with optional modules (Python)",
      "inherits": "win-msvc",
      "cacheVariables": {
        "FORGE3D_WITH_PYTHON": "ON",
        "VCPKG_MANIFEST_FEATURES": "python"
      }
    },
    {
      "name": "linux-gcc-full",
      "displayName": "linux-gcc with optional modules (Python)",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "FORGE3D_WITH_PYTHON": "ON",
        "VCPKG_MANIFEST_FEATURES": "python"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-release",
      "configurePreset": "win-msvc",
      "configuration": "Release"
    },
    {
      "name": "win-msvc-relwithdebinfo",
      "configurePreset": "win-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-clangcl-debug",
      "configurePreset": "win-clangcl",
      "configuration": "Debug"
    },
    {
      "name": "win-clangcl-release",
      "configurePreset": "win-clangcl",
      "configuration": "Release"
    },
    {
      "name": "win-clangcl-relwithdebinfo",
      "configurePreset": "win-clangcl",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-relwithdebinfo",
      "configurePreset": "linux-gcc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-relwithdebinfo",
      "configurePreset": "linux-clang",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-msvc-full-debug",
      "configurePreset": "win-msvc-full",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-full-release",
      "configurePreset": "win-msvc-full",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-full-debug",
      "configurePreset": "linux-gcc-full",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-full-release",
      "configurePreset": "linux-gcc-full",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "win-msvc-debug",
      "inherits": "test-base",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-release",
      "inherits": "test-base",
      "configurePreset": "win-msvc",
      "configuration": "Release"
    },
    {
      "name": "win-msvc-relwithdebinfo",
      "inherits": "test-base",
      "configurePreset": "win-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-clangcl-debug",
      "inherits": "test-base",
      "configurePreset": "win-clangcl",
      "configuration": "Debug"
    },
    {
      "name": "win-clangcl-release",
      "inherits": "test-base",
      "configurePreset": "win-clangcl",
      "configuration": "Release"
    },
    {
      "name": "win-clangcl-relwithdebinfo",
      "inherits": "test-base",
      "configurePreset": "win-clangcl",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-relwithdebinfo",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-relwithdebinfo",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-msvc-full-debug",
      "inherits": "test-base",
      "configurePreset": "win-msvc-full",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-full-release",
      "inherits": "test-base",
      "configurePreset": "win-msvc-full",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-full-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-full",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-full-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-full",
      "configuration": "Release"
    }
  ]
}
